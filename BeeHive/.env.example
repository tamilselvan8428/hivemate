PORT=5000
JWT_SECRET=your_super_secret_jwt_key_that_is_long_enough_for_hmac_sha256
MQTT_URL=mqtt://<broker_url>:1883
MQTT_USER=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password

# =========================================================================
# SMS PROVIDER SETTINGS (TWILIO / MSG91 / MOCK)
# IMPORTANT: DO NOT add a recipient phone number here!
# Alert SMS messages are sent dynamically to the authenticated user's
# registered phone number fetched from the database for their specific hive.
# =========================================================================
SMS_PROVIDER=MOCK

# Twilio Credentials (if SMS_PROVIDER=TWILIO)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# MSG91 Credentials (if SMS_PROVIDER=MSG91)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# ThingSpeak Settings
