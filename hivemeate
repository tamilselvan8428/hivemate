// Default temperature thresholds:
// HEATER_ON_THRESHOLD  = 30.0°C (turn ON when temp < 30.0°C)
// HEATER_OFF_THRESHOLD = 35.0°C (turn OFF when temp > 35.0°C)
// In-between (30°C - 35°C): Keep current state (hysteresis)
float heaterOnThreshold  = 30.0;
float heaterOffThreshold = 35.0;

// Control Mode: "AUTO" or "MANUAL" (default AUTO)
