#include <HTTPClient.h>
#include <WiFiClientSecure.h>
#include <ArduinoJson.h>
#include <DHT.h>
#include "HX711.h"

// =====================================================
// WiFi
// =====================================================

const char* ssid = "Airtel_n000_8386";
const char* password = "air60300";

// =====================================================
// ThingSpeak Settings
// =====================================================

const char* thingSpeakServer = "http://api.thingspeak.com/update";
const char* thingSpeakChannelId = "3126283";
const char* thingSpeakWriteKey = "A0B9TJ5N4L8R72ZE";
const char* thingSpeakReadKey  = "C4SNIR7EP4W21360";

// Endpoint to read the last burner/heater command (Field 6 as plain text: "1" or "0")
const char* burnerPollUrl =
  "http://api.thingspeak.com/channels/3126283/fields/6/last.txt?api_key=C4SNIR7EP4W21360";

// =====================================================
// Device
// =====================================================

const int deviceId = 1;

// Relay / LED Active Logic:
// Set to false for standard LED or Active-HIGH relay (HIGH = ON, LOW = OFF)
// Set to true for Active-LOW relay module (LOW = ON, HIGH = OFF)
const bool RELAY_ACTIVE_LOW = false;

// =====================================================
// DHT11
// =====================================================

#define DHTPIN 4
#define DHTTYPE DHT11

DHT dht(DHTPIN, DHTTYPE);

// =====================================================
// pH Sensor UART
// =====================================================

HardwareSerial mySerial(2);

#define RXD2 16
#define TXD2 17

// =====================================================
// HX711 Load Cell
// =====================================================

#define HX711_DOUT 18
#define HX711_SCK  19

HX711 scale;

// IMPORTANT:
// Change this after calibrating your load cell.
float calibrationFactor = -7050.0;

// =====================================================
// LED
// =====================================================

const int ledPin = 2;

// =====================================================
// Variables & Timers
// =====================================================

float weight = 0.0;
float phValue = NAN;
float temperature = NAN;
float humidity = NAN;
bool burnerState = false; // Current state of the burner/heater (true = ON, false = OFF)

// Non-blocking timer tracking
unsigned long lastBurnerPollTime = 0;
const unsigned long burnerPollInterval = 5000; // Check ThingSpeak burner command every 5 seconds

unsigned long lastSensorReadTime = 0;
const unsigned long sensorReadInterval = 20000; // Read sensors & upload to ThingSpeak every 20 seconds

// =====================================================
// SETUP
// =====================================================

void setup() {

  Serial.begin(115200);

  delay(1000);

  Serial.println();
  Serial.println("====================================");
  Serial.println("       SMART BEE ESP32 SYSTEM");
  Serial.println("====================================");

  // -------------------------------
  // LED
  // -------------------------------

  pinMode(ledPin, OUTPUT);
  digitalWrite(ledPin, RELAY_ACTIVE_LOW ? HIGH : LOW);

  // -------------------------------
  // DHT11
  // -------------------------------

  dht.begin();

  // -------------------------------
  // pH UART
  // -------------------------------

  mySerial.begin(
    9600,
    SERIAL_8N1,
    RXD2,
    TXD2
  );

  // -------------------------------
  // HX711
  // -------------------------------

  scale.begin(
    HX711_DOUT,
    HX711_SCK
  );

  Serial.println("Initializing load cell...");

  if (scale.is_ready()) {

    Serial.println("HX711 connected.");

    scale.set_scale(calibrationFactor);

    scale.tare();

    Serial.println("Load cell tare completed.");

  } else {

    Serial.println("WARNING: HX711 not detected.");

  }

  // -------------------------------
  // WiFi
  // -------------------------------

  Serial.print("Connecting to WiFi");

  WiFi.begin(
    ssid,
    password
  );

  while (WiFi.status() != WL_CONNECTED) {

    delay(500);

    Serial.print(".");
  }

  Serial.println();

  Serial.println("WiFi Connected!");

  Serial.print("ESP32 IP Address: ");

  Serial.println(
    WiFi.localIP()
  );

  Serial.println("====================================");
}


// =====================================================
// =====================================================
// SENSOR READING & UPLOAD
// =====================================================

void readAndUploadSensors() {

  Serial.println();
  Serial.println("====================================");
  Serial.println("Reading sensors...");
  Serial.println("====================================");

  // ---------------------------------------------------
  // 1. Read pH sensor
  // ---------------------------------------------------

  String sensorData = "";
  unsigned long startWait = millis();
  while (millis() - startWait < 150) {
    while (mySerial.available()) {
      char c = mySerial.read();
      sensorData += c;
    }
    delay(10);
  }

  phValue = extractPH(sensorData);


  // ---------------------------------------------------
  // 2. Read DHT11
  // ---------------------------------------------------

  temperature = dht.readTemperature();
  humidity = dht.readHumidity();


  // ---------------------------------------------------
  // 3. Read Load Cell
  // ---------------------------------------------------

  if (scale.is_ready()) {
    weight = scale.get_units(5);

    // Avoid tiny negative values
    if (weight < 0) {
      weight = 0;
    }

  } else {
    Serial.println("HX711 not ready!");
    weight = NAN;
  }


  // ---------------------------------------------------
  // 4. Print sensor data
  // ---------------------------------------------------

  Serial.println();
  Serial.println("========== SENSOR DATA ==========");
  Serial.print("Raw pH Data: ");
  Serial.println(sensorData);

  Serial.print("Device ID: ");
  Serial.println(deviceId);

  Serial.print("Temperature: ");
  if (!isnan(temperature))
    Serial.print(temperature);
  else
    Serial.print("ERROR");
  Serial.println(" °C");

  Serial.print("Humidity: ");
  if (!isnan(humidity))
    Serial.print(humidity);
  else
    Serial.print("ERROR");
  Serial.println(" %");

  Serial.print("pH: ");
  if (!isnan(phValue))
    Serial.println(phValue);
  else
    Serial.println("ERROR");

  Serial.print("Weight: ");
  if (!isnan(weight))
    Serial.print(weight);
  else
    Serial.print("ERROR");
  Serial.println(" kg");
  Serial.println("=================================");


  // ---------------------------------------------------
  // 5. Upload to ThingSpeak
  // ---------------------------------------------------

  // Upload as long as temperature and humidity are valid
  if (!isnan(temperature) && !isnan(humidity)) {
    if (isnan(phValue)) {
      Serial.println("Note: pH not ready; proceeding with Temp, Humidity & Weight.");
    }
    uploadToThingSpeak();
  } else {
    Serial.println();
    Serial.println("WARNING: DHT11 temperature/humidity failed.");
    Serial.println("Skipping ThingSpeak upload.");
  }
}


// =====================================================
// LOOP
// =====================================================

void loop() {

  // Ensure WiFi is connected
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("WiFi disconnected! Reconnecting...");
    WiFi.reconnect();
    delay(1000);
    return;
  }

  unsigned long currentMillis = millis();

  // 1. Fast check for Burner state from ThingSpeak (every 5 seconds)
  if (currentMillis - lastBurnerPollTime >= burnerPollInterval || lastBurnerPollTime == 0) {
    lastBurnerPollTime = currentMillis;
    fetchBurnerState();
  }

  // 2. Read sensors and upload to ThingSpeak (every 20 seconds)
  if (currentMillis - lastSensorReadTime >= sensorReadInterval || lastSensorReadTime == 0) {
    lastSensorReadTime = currentMillis;
    readAndUploadSensors();
  }

  delay(50);
}


// =====================================================
// THINGSPEAK UPLOAD
// =====================================================

void uploadToThingSpeak() {

  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("WiFi disconnected!");
    return;
  }

  HTTPClient http;

  // Include current burnerState in field6 so it doesn't get erased
  String url =
    String(thingSpeakServer) +
    "?api_key=" + String(thingSpeakWriteKey) +
    "&field1=" + String(deviceId) +
    "&field2=" + String(temperature, 2) +
    "&field3=" + String(humidity, 2) +
    "&field4=" + (isnan(phValue) ? "0.00" : String(phValue, 2)) +
    "&field5=" + (isnan(weight) ? "0.00" : String(weight, 2)) +
    "&field6=" + String(burnerState ? "1" : "0");

  Serial.println();
  Serial.println("Uploading data to ThingSpeak...");
  Serial.println(url);

  http.begin(url);
  int httpCode = http.GET();

  if (httpCode > 0) {
    Serial.print("ThingSpeak HTTP Code: ");
    Serial.println(httpCode);

    String response = http.getString();
    Serial.print("ThingSpeak Response: ");
    Serial.println(response);

    if (response != "0") {
      Serial.println("ThingSpeak upload successful!");
    } else {
      Serial.println("ThingSpeak returned 0 (rate limited).");
    }
  } else {
    Serial.print("ThingSpeak upload failed: ");
    Serial.println(httpCode);
  }

  http.end();
}


// =====================================================
// FETCH BURNER STATE FROM THINGSPEAK
// =====================================================

void fetchBurnerState() {

  if (WiFi.status() != WL_CONNECTED) {
    return;
  }

  HTTPClient http;

  if (http.begin(burnerPollUrl)) {
    int httpCode = http.GET();

    if (httpCode == HTTP_CODE_OK) {
      String response = http.getString();
      response.trim();

      Serial.print("[THINGSPEAK BURNER] Field 6: ");
      Serial.println(response);

      if (response == "1") {
        burnerState = true;
        digitalWrite(ledPin, RELAY_ACTIVE_LOW ? LOW : HIGH);
        Serial.println("[BURNER] Hardware State: ON");
      } else if (response == "0") {
        burnerState = false;
        digitalWrite(ledPin, RELAY_ACTIVE_LOW ? HIGH : LOW);
        Serial.println("[BURNER] Hardware State: OFF");
      }
      // If "-1" or other, keep existing state
    } else {
      Serial.print("[THINGSPEAK BURNER] Polling failed, HTTP Code: ");
      Serial.println(httpCode);
    }

    http.end();
  } else {
    Serial.println("[THINGSPEAK BURNER] Unable to begin HTTP client.");
  }
}


// =====================================================
// EXTRACT pH
// =====================================================

float extractPH(String data) {

  int phIndex =
    data.indexOf("PH:");


  if (phIndex == -1) {

    return NAN;
  }


  int commaIndex =
    data.indexOf(
      ',',
      phIndex
    );


  String phString;


  if (commaIndex != -1) {

    phString =
      data.substring(
        phIndex + 3,
        commaIndex
      );

  } else {

    phString =
      data.substring(
        phIndex + 3
      );
  }


  phString.trim();


  float value =
    phString.toFloat();


  if (
    value <= 0 ||
    value > 14
  ) {

    return NAN;
  }


  return value;
}