// =====================================================
// SETUP
// =====================================================

void setup() {
  Serial.begin(115200);
  delay(1000);

  Serial.println();
  Serial.println("=================================================");
  Serial.println("   SMART BEE HIVE - HYSTERESIS HEATER SYSTEM    ");
  Serial.println("   Mobile Alerts & Automatic Temperature Control");
  Serial.println("=================================================");

  // 1. Initialize Relay / LED pin (Default to safe OFF state)
  pinMode(heaterRelayPin, OUTPUT);
  setHardwareRelay(false);

  // 2. Initialize DHT11
  dht.begin();

  // 3. Initialize pH UART
  mySerial.begin(9600, SERIAL_8N1, RXD2, TXD2);

  // 4. Initialize HX711 Load Cell
  scale.begin(HX711_DOUT, HX711_SCK);
  Serial.println("Initializing load cell...");
  if (scale.is_ready()) {
    Serial.println("HX711 connected.");
    scale.set_scale(calibrationFactor);
    scale.tare();
    Serial.println("Load cell tare completed.");
  } else {
    Serial.println("WARNING: HX711 not detected.");
  }

  // 5. Connect to WiFi
  Serial.print("Connecting to WiFi: ");
  Serial.println(ssid);
  WiFi.begin(ssid, password);
  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 30) {
    delay(500);
    Serial.print(".");
    attempts++;
  }

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println();
    Serial.println("WiFi Connected!");
    Serial.print("ESP32 IP Address: ");
    Serial.println(WiFi.localIP());
  } else {
    Serial.println();
    Serial.println("WiFi Connection Failed! Will retry in main loop.");
  }

  Serial.println("=================================================");
}


// =====================================================
// HARDWARE RELAY CONTROL
// =====================================================

void setHardwareRelay(bool state) {
  if (RELAY_ACTIVE_LOW) {
    digitalWrite(heaterRelayPin, state ? LOW : HIGH);
  } else {
    digitalWrite(heaterRelayPin, state ? HIGH : LOW);
  }
}


// =====================================================
// TEMPERATURE HYSTERESIS & HEATER SAFETY LOGIC
// =====================================================

void applyHeaterLogic(float temp) {
  bool targetState = burnerState;
  String reason = "";

  if (controlMode == "AUTO") {
    // Sensor Failure Safety: Fallback to safe OFF state if sensor returns NaN
    if (isnan(temp)) {
      targetState = false;
      reason = "Temperature sensor unavailable (Safety Fallback)";
      Serial.println("[SAFETY] DHT11 returned NaN! Heater forced to safe OFF.");
    }
    // Hysteresis Rule 1: Below ON threshold -> Turn ON
    else if (temp < heaterOnThreshold) {
      targetState = true;
      reason = "Temperature (" + String(temp, 1) + "C) below " + String(heaterOnThreshold, 1) + "C";
    }
    // Hysteresis Rule 2: Above OFF threshold -> Turn OFF
    else if (temp > heaterOffThreshold) {
      targetState = false;
      reason = "Temperature (" + String(temp, 1) + "C) above " + String(heaterOffThreshold, 1) + "C";
    }
    // Hysteresis Rule 3: Within band [30°C - 35°C] -> Retain previous state
    else {
      targetState = burnerState;
      reason = "Temperature (" + String(temp, 1) + "C) within hysteresis band (" +
               String(heaterOnThreshold, 1) + "C - " + String(heaterOffThreshold, 1) + "C). State maintained.";
    }
  } else {
    // MANUAL Mode: Direct user command from Software / ThingSpeak
    targetState = manualHeaterCommand;
    reason = "Manual control command executed";
  }

  currentReason = reason;

  // Detect ACTUAL state transition (OFF -> ON or ON -> OFF)
  bool stateChanged = (!isFirstRun && targetState != previousBurnerState);

  // Apply to physical relay & status LED
  burnerState = targetState;
  setHardwareRelay(burnerState);

  Serial.print("[HEATER LOGIC] State: ");
  Serial.print(burnerState ? "ON" : "OFF");
  Serial.print(" | Mode: ");
  Serial.print(controlMode);
  Serial.print(" | Reason: ");
  Serial.println(currentReason);

  if (stateChanged || isFirstRun) {
    if (stateChanged) {
      Serial.println(">>> STATE CHANGE DETECTED! Sending mobile notification alert to backend...");
    }
    previousBurnerState = burnerState;
    isFirstRun = false;
  }

  // Send telemetry to backend:
  // Updates online status, thresholds, and dispatches top-bar mobile notifications if state changed
  sendTelemetryToBackend(temp, humidity, burnerState, controlMode, currentReason, stateChanged);
}


// =====================================================
// BACKEND TELEMETRY & MOBILE NOTIFICATION DISPATCH
// =====================================================

void sendTelemetryToBackend(float temp, float hum, bool heaterOn, String mode, String reason, bool stateChanged) {
  if (WiFi.status() != WL_CONNECTED) {
    return;
  }

  HTTPClient http;
  http.begin(backendTelemetryUrl);
  http.addHeader("Content-Type", "application/json");

  if (deviceApiKey != NULL && strlen(deviceApiKey) > 0) {
    http.addHeader("X-API-KEY", deviceApiKey);
  }

  // Build JSON payload (ArduinoJson v6 & v7 compatible)
#if ARDUINOJSON_VERSION_MAJOR >= 7
  JsonDocument doc;
#else
  StaticJsonDocument<384> doc;
#endif

  doc["farmId"] = deviceFarmId;
  doc["temperature"] = isnan(temp) ? 0.0 : temp;
  doc["humidity"] = isnan(hum) ? 0.0 : hum;
  doc["heater"] = heaterOn;
  doc["mode"] = mode;
  doc["reason"] = reason;

  String requestBody;
  serializeJson(doc, requestBody);

  int httpCode = http.POST(requestBody);
  if (httpCode > 0) {
    String response = http.getString();
    Serial.print("[BACKEND] Telemetry sync OK (HTTP ");
    Serial.print(httpCode);
    Serial.println(")");

    // Parse backend response to stay synchronized with user's dashboard settings
#if ARDUINOJSON_VERSION_MAJOR >= 7
    JsonDocument resDoc;
#else
    StaticJsonDocument<512> resDoc;
#endif
    DeserializationError err = deserializeJson(resDoc, response);
    if (!err) {
      // Sync dynamic thresholds from software dashboard
      if (resDoc.containsKey("onThreshold") && !resDoc["onThreshold"].isNull()) {
        heaterOnThreshold = resDoc["onThreshold"];
      }
      if (resDoc.containsKey("offThreshold") && !resDoc["offThreshold"].isNull()) {
        heaterOffThreshold = resDoc["offThreshold"];
      }
      // Sync mode from software dashboard
      if (resDoc.containsKey("mode") && !resDoc["mode"].isNull()) {
        const char* m = resDoc["mode"];
        controlMode = String(m);
      }
      // Sync manual command if in MANUAL mode
      if (controlMode == "MANUAL" && resDoc.containsKey("heaterStatus") && !resDoc["heaterStatus"].isNull()) {
        const char* hs = resDoc["heaterStatus"];
        manualHeaterCommand = (strcmp(hs, "ON") == 0);
      }
    }
  } else {
    Serial.print("[BACKEND] Telemetry failed: ");
    Serial.println(http.errorToString(httpCode));
  }

  http.end();
}


// =====================================================
// SENSOR READING & CONTROL EXECUTION
// =====================================================

void readAndUploadSensors() {
  Serial.println();
  Serial.println("=================================================");
  Serial.println("Reading sensors & evaluating heater...");
  Serial.println("=================================================");

  // 1. Read pH sensor
  String sensorData = "";
  unsigned long startWait = millis();
  while (millis() - startWait < 150) {
    while (mySerial.available()) {
      char c = mySerial.read();
      sensorData += c;
    }
    delay(10);
  }
  phValue = extractPH(sensorData);

  // 2. Read DHT11 Temperature & Humidity
  temperature = dht.readTemperature();
  humidity = dht.readHumidity();

  // 3. Read HX711 Load Cell
  if (scale.is_ready()) {
    weight = scale.get_units(5);
    if (weight < 0) {
      weight = 0;
    }
  } else {
    weight = NAN;
  }

  // Print formatted telemetry
  Serial.println("========== SENSOR TELEMETRY ==========");
  Serial.print("Farm ID:     "); Serial.println(deviceFarmId);
  Serial.print("Temperature: ");
  if (!isnan(temperature)) { Serial.print(temperature, 1); Serial.println(" °C"); }
  else { Serial.println("DHT11 ERROR (NaN)"); }
  Serial.print("Humidity:    ");
  if (!isnan(humidity)) { Serial.print(humidity, 1); Serial.println(" %"); }
  else { Serial.println("DHT11 ERROR"); }
  Serial.print("pH Value:    ");
  if (!isnan(phValue)) { Serial.println(phValue, 2); }
  else { Serial.println("UART Offline"); }
  Serial.print("Hive Weight: ");
  if (!isnan(weight)) { Serial.print(weight, 2); Serial.println(" kg"); }
  else { Serial.println("HX711 Offline"); }
  Serial.println("======================================");

  // 4. Apply Temperature Hysteresis & Safety Logic
  applyHeaterLogic(temperature);

  // 5. Upload to ThingSpeak (Fields 1-8 preserved)
  if (!isnan(temperature) && !isnan(humidity)) {
    uploadToThingSpeak();
  }
}


// =====================================================
// MAIN LOOP
// =====================================================

void loop() {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("WiFi disconnected! Reconnecting...");
    WiFi.reconnect();
    delay(2000);
    return;
  }

  unsigned long currentMillis = millis();

  // 1. Check control mode & manual commands from Backend / ThingSpeak (every 5 seconds)
  if (currentMillis - lastControlPollTime >= controlPollInterval || lastControlPollTime == 0) {
    lastControlPollTime = currentMillis;
    fetchControlCommands();
  }

  // 2. Read sensors, evaluate hysteresis logic & dispatch notifications (every 15 seconds)
  if (currentMillis - lastSensorReadTime >= sensorReadInterval || lastSensorReadTime == 0) {
    lastSensorReadTime = currentMillis;
    readAndUploadSensors();
  }

  delay(50);
}


// =====================================================
// THINGSPEAK UPLOAD (Fields 1 - 8)
// Field 1 = Device / Farm ID
// Field 2 = Temperature (°C)
// Field 3 = Humidity (%)
// Field 4 = pH
// Field 5 = Weight (kg)
// Field 6 = Heater State (0 = OFF, 1 = ON)
// Field 7 = Control Mode (0 = AUTO, 1 = MANUAL)
// Field 8 = Manual Heater Command (0 = OFF, 1 = ON)
// =====================================================

void uploadToThingSpeak() {
  if (WiFi.status() != WL_CONNECTED) return;

  HTTPClient http;

  String url =
    String(thingSpeakServer) +
    "?api_key=" + String(thingSpeakWriteKey) +
    "&field1=" + String(deviceFarmId) +
    "&field2=" + String(temperature, 2) +
    "&field3=" + String(humidity, 2) +
    "&field4=" + (isnan(phValue) ? "0.00" : String(phValue, 2)) +
    "&field5=" + (isnan(weight) ? "0.00" : String(weight, 2)) +
    "&field6=" + String(burnerState ? "1" : "0") +
    "&field7=" + String(controlMode == "MANUAL" ? "1" : "0") +
    "&field8=" + String(manualHeaterCommand ? "1" : "0");

  http.begin(url);
  int httpCode = http.GET();

  if (httpCode > 0) {
    String response = http.getString();
    if (response != "0") {
      Serial.println("[THINGSPEAK] Upload successful (Entry: " + response + ")");
    } else {
      Serial.println("[THINGSPEAK] Rate limited (requires 15s interval).");
    }
  } else {
    Serial.print("[THINGSPEAK] Upload failed: ");
    Serial.println(httpCode);
  }

  http.end();
}


// =====================================================
// FETCH CONTROL COMMANDS (Backend sync with ThingSpeak fallback)
// =====================================================

void fetchControlCommands() {
  if (WiFi.status() != WL_CONNECTED) return;

  // 1. Primary: Sync directly from Backend Server
  HTTPClient http;
  if (http.begin(backendStatusUrl)) {
    http.setTimeout(2500);
    int httpCode = http.GET();
    if (httpCode == HTTP_CODE_OK) {
      String response = http.getString();
#if ARDUINOJSON_VERSION_MAJOR >= 7
      JsonDocument doc;
#else
      StaticJsonDocument<512> doc;
#endif
      DeserializationError error = deserializeJson(doc, response);
      if (!error) {
        if (doc.containsKey("mode") && !doc["mode"].isNull()) {
          controlMode = String((const char*)doc["mode"]);
        }
        if (doc.containsKey("onThreshold") && !doc["onThreshold"].isNull()) {
          heaterOnThreshold = doc["onThreshold"];
        }
        if (doc.containsKey("offThreshold") && !doc["offThreshold"].isNull()) {
          heaterOffThreshold = doc["offThreshold"];
        }
        if (controlMode == "MANUAL" && doc.containsKey("heaterStatus") && !doc["heaterStatus"].isNull()) {
          const char* hs = doc["heaterStatus"];
          manualHeaterCommand = (strcmp(hs, "ON") == 0);
        }
        http.end();
        return; // Synchronized via backend
      }
    }
    http.end();
  }

  // 2. Fallback: Sync via ThingSpeak Channel Fields 6, 7, 8
  if (http.begin(thingSpeakLastFeedUrl)) {
    http.setTimeout(3000);
    int httpCode = http.GET();
    if (httpCode == HTTP_CODE_OK) {
      String response = http.getString();
#if ARDUINOJSON_VERSION_MAJOR >= 7
      JsonDocument doc;
#else
      StaticJsonDocument<512> doc;
#endif
      DeserializationError error = deserializeJson(doc, response);

      if (!error) {
        // Field 7: Control Mode (0 = AUTO, 1 = MANUAL)
        if (doc.containsKey("field7") && !doc["field7"].isNull()) {
          const char* f7 = doc["field7"];
          controlMode = (strcmp(f7, "1") == 0) ? "MANUAL" : "AUTO";
        }

        // Field 8: Manual Heater Command (0 = OFF, 1 = ON)
        if (doc.containsKey("field8") && !doc["field8"].isNull()) {
          const char* f8 = doc["field8"];
          manualHeaterCommand = (strcmp(f8, "1") == 0);
        }

        // Field 6 fallback for manual heater state
        if (controlMode == "MANUAL" && doc.containsKey("field6") && !doc["field6"].isNull()) {
          const char* f6 = doc["field6"];
          manualHeaterCommand = (strcmp(f6, "1") == 0);
        }
      }
    }
    http.end();
  }
}


// =====================================================
// EXTRACT pH VALUE FROM UART STRING
// =====================================================

float extractPH(String data) {
  int phIndex = data.indexOf("PH:");
  if (phIndex == -1) return NAN;

  int commaIndex = data.indexOf(',', phIndex);
  String phString;

  if (commaIndex != -1) {
    phString = data.substring(phIndex + 3, commaIndex);
  } else {
    phString = data.substring(phIndex + 3);
  }

  phString.trim();
  float value = phString.toFloat();

  if (value <= 0 || value > 14) return NAN;
  return value;
}