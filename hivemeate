// =====================================================
// SETUP
// =====================================================

void setup() {
  Serial.begin(115200);
  delay(1000);

  Serial.println();
  Serial.println("=================================================");
  Serial.println("   SMART BEE HIVE - HYSTERESIS HEATER SYSTEM    ");
  Serial.println("=================================================");

  // 1. Initialize Relay / LED pin (Default to safe OFF state)
  pinMode(heaterRelayPin, OUTPUT);
  setHardwareRelay(false);

  // 2. Initialize DHT11
  dht.begin();

  // 3. Initialize pH UART
  mySerial.begin(9600, SERIAL_8N1, RXD2, TXD2);

  // 4. Initialize HX711 Load Cell
  scale.begin(HX711_DOUT, HX711_SCK);
  Serial.println("Initializing load cell...");
  if (scale.is_ready()) {
    Serial.println("HX711 connected.");
    scale.set_scale(calibrationFactor);
    scale.tare();
    Serial.println("Load cell tare completed.");
  } else {
    Serial.println("WARNING: HX711 not detected.");
  }

  // 5. Connect to WiFi
  Serial.print("Connecting to WiFi");
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println();
  Serial.println("WiFi Connected!");
  Serial.print("ESP32 IP Address: ");
  Serial.println(WiFi.localIP());
  Serial.println("=================================================");
}


// =====================================================
// HARDWARE RELAY CONTROL (Requirement 7)
// =====================================================

void setHardwareRelay(bool state) {
  if (RELAY_ACTIVE_LOW) {
    digitalWrite(heaterRelayPin, state ? LOW : HIGH);
  } else {
    digitalWrite(heaterRelayPin, state ? HIGH : LOW);
  }
}


// =====================================================
// TEMPERATURE HYSTERESIS & MODE LOGIC (Req 2, 3, 8, 9)
// =====================================================

void applyHeaterLogic(float temp) {
  bool targetState = burnerState;
  String reason = "";

  if (controlMode == "AUTO") {
    // Requirement 8: Sensor Failure Safety
    if (isnan(temp)) {
      targetState = false; // Safe default OFF
      reason = "Temperature sensor unavailable";
      Serial.println("[SAFETY] DHT11 returned NaN! Heater forced to safe OFF.");
    }
    // Requirement 2: Hysteresis Logic
    else if (temp < heaterOnThreshold) {
      targetState = true;
      reason = "Temperature below " + String(heaterOnThreshold, 1) + "C";
    }
    else if (temp > heaterOffThreshold) {
      targetState = false;
      reason = "Temperature above " + String(heaterOffThreshold, 1) + "C";
    }
    else {
      // 30°C <= temp <= 35°C: Keep previous heater state
      targetState = burnerState;
      reason = "Temperature within hysteresis band (" + String(heaterOnThreshold, 1) + "C - " + String(heaterOffThreshold, 1) + "C)";
    }
  } else {
    // Requirement 3: MANUAL Mode
    targetState = manualHeaterCommand;
    reason = "Manual control";
  }

  currentReason = reason;

  // Requirement 9 & 20: Detect ACTUAL state changes (OFF -> ON or ON -> OFF)
  bool stateChanged = (isFirstRun || targetState != previousBurnerState);

  // Apply to physical relay & LED indicator
  burnerState = targetState;
  setHardwareRelay(burnerState);

  Serial.print("[HEATER CONTROLLER] State: ");
  Serial.print(burnerState ? "ON" : "OFF");
  Serial.print(" | Mode: ");
  Serial.print(controlMode);
  Serial.print(" | Reason: ");
  Serial.println(currentReason);

  if (stateChanged) {
    Serial.println(">>> ACTUAL HEATER STATE TRANSITION DETECTED! Notifying backend for SMS dispatch...");
    notifyBackendStateChange(temp, burnerState, controlMode, currentReason);
    previousBurnerState = burnerState;
    isFirstRun = false;
  }
}


// =====================================================
// NOTIFY BACKEND STATE CHANGE (Requirement 6, 8, 9, 10)
// =====================================================

void notifyBackendStateChange(float temp, bool newState, String mode, String reason) {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("[BACKEND NOTIFY] Skipped: WiFi disconnected.");
    return;
  }

  HTTPClient http;
  http.begin(backendTelemetryUrl);
  http.addHeader("Content-Type", "application/json");

  if (deviceApiKey != NULL && strlen(deviceApiKey) > 0) {
    http.addHeader("X-API-KEY", deviceApiKey);
  }

  // Construct JSON payload
  StaticJsonDocument<256> doc;
  doc["farmId"] = deviceId;
  doc["temperature"] = isnan(temp) ? 0.0 : temp;
  doc["humidity"] = isnan(humidity) ? 0.0 : humidity;
  doc["heater"] = newState;
  doc["mode"] = mode;
  doc["reason"] = reason;

  String requestBody;
  serializeJson(doc, requestBody);

  Serial.println("[BACKEND NOTIFY] Sending state change to backend...");
  Serial.println(requestBody);

  int httpCode = http.POST(requestBody);
  if (httpCode > 0) {
    Serial.print("[BACKEND NOTIFY] Response code: ");
    Serial.println(httpCode);
    String response = http.getString();
    Serial.print("[BACKEND NOTIFY] Response: ");
    Serial.println(response);
  } else {
    Serial.print("[BACKEND NOTIFY] Failed, error: ");
    Serial.println(http.errorToString(httpCode));
  }

  http.end();
}


// =====================================================
// SENSOR READING & UPLOAD
// =====================================================

void readAndUploadSensors() {
  Serial.println();
  Serial.println("=================================================");
  Serial.println("Reading sensors...");
  Serial.println("=================================================");

  // 1. Read pH sensor
  String sensorData = "";
  unsigned long startWait = millis();
  while (millis() - startWait < 150) {
    while (mySerial.available()) {
      char c = mySerial.read();
      sensorData += c;
    }
    delay(10);
  }
  phValue = extractPH(sensorData);

  // 2. Read DHT11
  temperature = dht.readTemperature();
  humidity = dht.readHumidity();

  // 3. Read Load Cell
  if (scale.is_ready()) {
    weight = scale.get_units(5);
    if (weight < 0) {
      weight = 0;
    }
  } else {
    Serial.println("HX711 not ready!");
    weight = NAN;
  }

  // Print sensor data
  Serial.println("========== SENSOR TELEMETRY ==========");
  Serial.print("Device ID: ");
  Serial.println(deviceId);
  Serial.print("Temperature: ");
  if (!isnan(temperature)) Serial.print(temperature); else Serial.print("ERROR (NaN)");
  Serial.println(" °C");
  Serial.print("Humidity: ");
  if (!isnan(humidity)) Serial.print(humidity); else Serial.print("ERROR");
  Serial.println(" %");
  Serial.print("pH: ");
  if (!isnan(phValue)) Serial.println(phValue); else Serial.println("ERROR");
  Serial.print("Weight: ");
  if (!isnan(weight)) Serial.print(weight); else Serial.print("ERROR");
  Serial.println(" kg");
  Serial.println("======================================");

  // 4. Apply Temperature Hysteresis & Heater Safety Decisions
  applyHeaterLogic(temperature);

  // 5. Upload to ThingSpeak (Requirement 5)
  if (!isnan(temperature) && !isnan(humidity)) {
    uploadToThingSpeak();
  } else {
    Serial.println("WARNING: DHT11 temperature/humidity failed. Skipping ThingSpeak upload.");
  }
}


// =====================================================
// MAIN LOOP
// =====================================================

void loop() {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("WiFi disconnected! Reconnecting...");
    WiFi.reconnect();
    delay(1000);
    return;
  }

  unsigned long currentMillis = millis();

  // 1. Check control mode & manual commands from ThingSpeak (every 5 seconds)
  if (currentMillis - lastControlPollTime >= controlPollInterval || lastControlPollTime == 0) {
    lastControlPollTime = currentMillis;
    fetchControlCommands();
  }

  // 2. Read sensors, apply hysteresis logic & upload to ThingSpeak (every 20 seconds)
  if (currentMillis - lastSensorReadTime >= sensorReadInterval || lastSensorReadTime == 0) {
    lastSensorReadTime = currentMillis;
    readAndUploadSensors();
  }

  delay(50);
}


// =====================================================
// THINGSPEAK UPLOAD (Requirement 5)
// Field 1 = Device ID
// Field 2 = Temperature
// Field 3 = Humidity
// Field 4 = pH
// Field 5 = Weight
// Field 6 = Heater State (0 = OFF, 1 = ON)
// Field 7 = Control Mode (0 = AUTO, 1 = MANUAL)
// Field 8 = Manual Heater Command (0 = OFF, 1 = ON)
// =====================================================

void uploadToThingSpeak() {
  if (WiFi.status() != WL_CONNECTED) return;

  HTTPClient http;

  String url =
    String(thingSpeakServer) +
    "?api_key=" + String(thingSpeakWriteKey) +
    "&field1=" + String(deviceId) +
    "&field2=" + String(temperature, 2) +
    "&field3=" + String(humidity, 2) +
    "&field4=" + (isnan(phValue) ? "0.00" : String(phValue, 2)) +
    "&field5=" + (isnan(weight) ? "0.00" : String(weight, 2)) +
    "&field6=" + String(burnerState ? "1" : "0") +
    "&field7=" + String(controlMode == "MANUAL" ? "1" : "0") +
    "&field8=" + String(manualHeaterCommand ? "1" : "0");

  Serial.println("[THINGSPEAK] Uploading channel data...");
  http.begin(url);
  int httpCode = http.GET();

  if (httpCode > 0) {
    String response = http.getString();
    if (response != "0") {
      Serial.println("[THINGSPEAK] Upload successful!");
    } else {
      Serial.println("[THINGSPEAK] Rate limited (wait 15s).");
    }
  } else {
    Serial.print("[THINGSPEAK] Upload failed: ");
    Serial.println(httpCode);
  }

  http.end();
}


// =====================================================
// FETCH CONTROL COMMANDS (Fields 6, 7, 8)
// =====================================================

void fetchControlCommands() {
  if (WiFi.status() != WL_CONNECTED) return;

  HTTPClient http;
  if (http.begin(thingSpeakLastFeedUrl)) {
    int httpCode = http.GET();
    if (httpCode == HTTP_CODE_OK) {
      String response = http.getString();
      StaticJsonDocument<512> doc;
      DeserializationError error = deserializeJson(doc, response);

      if (!error) {
        // Field 7: Control Mode (0 = AUTO, 1 = MANUAL)
        if (doc.containsKey("field7") && !doc["field7"].isNull()) {
          const char* f7 = doc["field7"];
          if (strcmp(f7, "1") == 0) {
            controlMode = "MANUAL";
          } else if (strcmp(f7, "0") == 0) {
            controlMode = "AUTO";
          }
        }

        // Field 8: Manual Heater Command (0 = OFF, 1 = ON)
        if (doc.containsKey("field8") && !doc["field8"].isNull()) {
          const char* f8 = doc["field8"];
          if (strcmp(f8, "1") == 0) {
            manualHeaterCommand = true;
          } else if (strcmp(f8, "0") == 0) {
            manualHeaterCommand = false;
          }
        }

        // Fallback for field 6 if manual mode
        if (controlMode == "MANUAL" && doc.containsKey("field6") && !doc["field6"].isNull()) {
          const char* f6 = doc["field6"];
          if (strcmp(f6, "1") == 0) {
            manualHeaterCommand = true;
          } else if (strcmp(f6, "0") == 0) {
            manualHeaterCommand = false;
          }
        }
      }
    }
    http.end();
  }
}


// =====================================================
// EXTRACT pH
// =====================================================

float extractPH(String data) {
  int phIndex = data.indexOf("PH:");
  if (phIndex == -1) return NAN;

  int commaIndex = data.indexOf(',', phIndex);
  String phString;

  if (commaIndex != -1) {
    phString = data.substring(phIndex + 3, commaIndex);
  } else {
    phString = data.substring(phIndex + 3);
  }

  phString.trim();
  float value = phString.toFloat();

  if (value <= 0 || value > 14) return NAN;
  return value;
}